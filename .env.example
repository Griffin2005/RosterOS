# Copy to .env and change every secret before deploying anywhere public.

# --- Postgres (docker compose) ---
POSTGRES_USER=rosteros
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rosteros
REPLICATION_PASSWORD=change-me-too

# --- API ---
# development | production (production: secure cookies, HSTS, no public API docs,
# refuses to start with a weak JWT_SECRET or without ADMIN_PASSWORD)
ENV=development
JWT_SECRET=generate-at-least-32-random-characters
# Passwords for the seeded accounts. Never commit real values. Each must meet the
# policy: 12+ chars, upper and lower case, a number, a symbol, no username inside.
# Leave empty in development to have random ones generated and printed once.
ADMIN_PASSWORD= 
DEMO_PASSWORD=
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SOLVER_TIME_LIMIT_S=30
SOLVER_WORKERS=8

# --- Google Sheets / Calendar ---
# embedded = in-process mock (local dev); http = SHEETS_BASE_URL (sheets-mock container or https://sheets.googleapis.com)
SHEETS_MODE=embedded
SHEETS_BASE_URL=http://sheets-mock:8100
GOOGLE_ACCESS_TOKEN=
RULES_SPREADSHEET_ID=rules-and-coverage
DASHBOARD_SPREADSHEET_ID=roster-dashboards
HOLIDAY_CALENDAR_IDS=IN-NATIONAL,IN-WB,IN-MH

# --- AI assistant (optional; without it the assistant answers from the validator) ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
